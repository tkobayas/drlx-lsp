{
  "name": "vscode-extension-drlx-editor",
  "displayName": "DRLX Editor",
  "description": "Edit DRLX (Drools Rule Language eXtension) files",
  "publisher": "kie-group",
  "version": "1.0.0-alpha",
  "repository": {
    "type": "git",
    "url": "https://github.com/tkobayas/drlx-lsp.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:drlx"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.vscode-extension-drlx-editor",
        "title": "DRLX"
      }
    ],
    "languages": [
      {
        "id": "drlx",
        "aliases": [
          "DRLX",
          "drlx"
        ],
        "extensions": [
          ".drlx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "drlx",
        "scopeName": "source.drlx",
        "path": "./syntaxes/drlx.tmLanguage"
      }
    ],
    "javaExtensions": [
      "./lib/drlx-lsp-server-jar-with-dependencies.jar"
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "pack:dev": "mkdir -p ./dist; vsce package --githubBranch main -o ./dist/"
  },
  "devDependencies": {
    "@types/glob": "8.1.0",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "1.125.0",
    "@typescript-eslint/eslint-plugin": "8.62.1",
    "@typescript-eslint/parser": "8.62.1",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.9.2",
    "eslint": "9.39.4",
    "glob": "11.1.0",
    "mocha": "11.7.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "serialize-javascript": "7.0.5",
    "diff": "8.0.4"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
